# Example overrides for swagger-coverage-tool. Copy to .env and adjust.
# .env is gitignored.
#
# IMPORTANT: swagger-coverage-tool's source precedence is
#   swagger_coverage_config.yaml > swagger_coverage_config.json > env > .env
# i.e. **YAML wins over env vars**. The variables below only take effect if
# swagger_coverage_config.yaml is not present in the working directory (or is
# replaced via a bind-mount, as CI does for the report step).
#
# All variables are top-level swagger-coverage-tool fields with the
# SWAGGER_COVERAGE_ prefix.

# Override the entire services list (use this for a different host/port).
# SWAGGER_COVERAGE_SERVICES=[{"key":"nbank","name":"NoBugs Bank API","tags":["API"],"swagger_url":"http://localhost:4111/v3/api-docs"}]

# Output locations (defaults work for most cases).
# SWAGGER_COVERAGE_RESULTS_DIR=./coverage-results
# SWAGGER_COVERAGE_HTML_REPORT_FILE=./coverage-results/index.html
# SWAGGER_COVERAGE_JSON_REPORT_FILE=./coverage-results/coverage-report.json
# SWAGGER_COVERAGE_HISTORY_FILE=./coverage-results/coverage-history.json
# SWAGGER_COVERAGE_HISTORY_RETENTION_LIMIT=30
